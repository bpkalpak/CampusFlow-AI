# CampusFlow AI Environment Configuration

# Required: Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Optional: Gemini model name. Defaults to gemini-3.8-flash if not specified.
# Supported options: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL="gemini-3.8-flash"

# Optional: Port number for local server (defaults to 3000)
PORT=3000

# Optional: Host URL for Cloud Run or remote deployments
APP_URL="http://localhost:3000"
